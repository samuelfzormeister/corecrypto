#include? "../darwinbuild.xcconfig"

#include "corecrypto.xcconfig"

// override base header path
PUBLIC_HEADERS_FOLDER_PATH = $(SDK_INSTALL_HEADERS_ROOT)/System/Library/Frameworks/Kernel.framework/Headers/corecrypto
PRIVATE_HEADERS_FOLDER_PATH = $(SDK_INSTALL_HEADERS_ROOT)/System/Library/Frameworks/Kernel.framework/PrivateHeaders/corecrypto

INSTALL_PATH = /System/Library/Extensions

OTHER_CFLAGS = -Wincompatible-function-pointer-types

HEADER_SEARCH_PATHS = $(HEADER_SEARCH_PATHS) $(SRCROOT)/src/cckprng/include

SYSTEM_HEADER_SEARCH_PATHS = $(DEPROOT)/System/Library/Frameworks/Kernel.framework/PrivateHeaders
FRAMEWORK_SEARCH_PATHS = // nothing
